# Groq LLM (chat + consult planner). If unset, a deterministic planner runs.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Live Node API base. MUST match the host the Flutter app talks to
# (lib/core/constants/api_constants.dart baseUrl), or tool/gate calls 404/401.
BACKEND_URL=https://medicoscope-api-lbto.onrender.com/api

# Shared secret for service-to-service calls (vitals ingest). Match the Node SERVICE_KEY.
SERVICE_KEY=

# Configured for roadmap only, not currently wired into any code path.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
